# Previa bloqueia indexacao por padrao. Habilitar somente apos revisao.
PUBLIC_INDEXABLE=false
PUBLIC_SITE_URL=https://nexoneuro.com

# Somente para o build local de revisão da editoria. Não configurar na hospedagem.
PUBLIC_EDITORIAL_PREVIEW=false

# Prévia pública editorial com PDFs/imagens cuja divulgação foi autorizada pelo titular.
# Mantém noindex obrigatório e não representa aprovação clínica.
PUBLIC_EDITORIAL_SHARED_PREVIEW=false
