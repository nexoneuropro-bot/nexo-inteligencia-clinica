# Previa bloqueia indexacao por padrao. Habilitar somente apos revisao.
PUBLIC_INDEXABLE=false
PUBLIC_SITE_URL=https://nexoneuro.com

# Somente para o build local de revisão da editoria. Não configurar na hospedagem.
PUBLIC_EDITORIAL_PREVIEW=false

# Prévia pública editorial com PDFs/imagens cuja divulgação foi autorizada pelo titular.
# Mantém noindex obrigatório e não representa aprovação clínica.
PUBLIC_EDITORIAL_SHARED_PREVIEW=false

# Conhecendo Meu Momento: configuração fechada da Fase 1.
# O build recusa ativação clínica sem a implementação dos pré-requisitos.
NEXO_DEMO_ONLY=true
NEXO_ENABLE_REAL_SUBMISSIONS=false
NEXO_ENABLE_SCALES=false
NEXO_ENABLE_STT=false
NEXO_ENABLE_RESEARCH=false
NEXO_ENABLE_CLINICAL_DASHBOARD=false

# Runtime clínico: configurar somente como variáveis/segredos de Pages Functions.
# Não usar prefixo PUBLIC_ nem colocar chaves neste arquivo/repositório.
NEXO_CLINICAL_ENABLED=false
NEXO_CLINICAL_PROTOCOL_APPROVED=false
NEXO_CLINICAL_PRIVACY_APPROVED=false
NEXO_CLINICAL_RETENTION_APPROVED=false
NEXO_CLINICAL_FREE_PLAN_CONFIRMED=false
NEXO_CLINICAL_ORIGIN=https://nexo-previa-20261014.pages.dev
# NEXO_CLINICAL_DB: associação D1, nunca uma URL pública.
# NEXO_CLINICAL_ENCRYPTION_KEY: segredo base64 com 32 bytes aleatórios.
# NEXO_CLINICAL_TOKEN_SECRET: segredo aleatório independente, mínimo 32 caracteres.
# RESEND_API_KEY: segredo já configurado no painel.
# NEXO_CLINICAL_MAIL_FROM: remetente autorizado no Resend.
