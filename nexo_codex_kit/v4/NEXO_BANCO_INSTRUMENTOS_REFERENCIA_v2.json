  "instruments": [
    {
      "instrument_id": "PHQ-9",
      "version_id": "phq9_ptbr_pfizer_form_2014_reference_v1",
      "source_name": "PHQ-9 Portuguese for Brazil Pfizer / PHQ Screeners",
      "source_url": "https://www.phqscreeners.com/images/sites/g/files/g10060481/f/201412/PHQ9_Portuguese%20for%20Brazil.pdf",
      "license_note": "No permission required to reproduce, translate, display or distribute (original form).",
      "recall_period_days": 14,
      "stem": "Durante as últimas 2 semanas, com que freqüência você foi incomodado/a por qualquer um dos problemas abaixo?",
      "items": [
        {
          "id": "PHQ01",
          "order": 1,
          "text": "Pouco interesse ou pouco prazer em fazer as coisas",
          "internal_domain": "interesse_prazer"
        },
        {
          "id": "PHQ02",
          "order": 2,
          "text": "Se sentir “para baixo”, deprimido/a ou sem perspectiva",
          "internal_domain": "humor_deprimido"
        },
        {
          "id": "PHQ03",
          "order": 3,
          "text": "Dificuldade para pegar no sono ou permanecer dormindo, ou dormir mais do que de costume",
          "internal_domain": "sono"
        },
        {
          "id": "PHQ04",
          "order": 4,
          "text": "Se sentir cansado/a ou com pouca energia",
          "internal_domain": "energia"
        },
        {
          "id": "PHQ05",
          "order": 5,
          "text": "Falta de apetite ou comendo demais",
          "internal_domain": "apetite"
        },
        {
          "id": "PHQ06",
          "order": 6,
          "text": "Se sentir mal consigo mesmo/a — ou achar que você é um fracasso ou que decepcionou sua família ou você mesmo/a",
          "internal_domain": "autovalor"
        },
        {
          "id": "PHQ07",
          "order": 7,
          "text": "Dificuldade para se concentrar nas coisas, como ler o jornal ou ver televisão",
          "internal_domain": "concentracao"
        },
        {
          "id": "PHQ08",
          "order": 8,
          "text": "Lentidão para se movimentar ou falar, a ponto das outras pessoas perceberem? Ou o oposto – estar tão agitado/a ou irrequieto/a que você fica andando de um lado para o outro muito mais do que de costume",
          "internal_domain": "psicomotor"
        },
        {
          "id": "PHQ09",
          "order": 9,
          "text": "Pensar em se ferir de alguma maneira ou que seria melhor estar morto/a",
          "internal_domain": "autolesao_ideacao_morte"
        }
      ],
      "range": [
        0,
        27
      ],
      "severity_bands_internal_only": [
        {
          "min": 0,
          "max": 4,
          "label": "Mínima ou ausente"
