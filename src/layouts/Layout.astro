---
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import Arrow from '../components/Arrow.astro';
import { whatsapp } from '../data/reflections';
import ExperienceNav from '../components/ExperienceNav.astro';
import ExperienceFooter from '../components/ExperienceFooter.astro';
import AmbientSound from '../components/AmbientSound.astro';
import '../styles/reading-comfort.css';
import { pages } from '../data/pages';
import {editorialPreview,hasConfirmedEditorialAuthorship,editorialAuthorName,type EditorialArticle} from '../data/editorial';
interface Props { title:string; description:string; home?:boolean; experience?:boolean; article?:EditorialArticle; image?:string; seoTitle?:string; }
const {title,description,home=false,experience=false,article,image,seoTitle}=Astro.props;
const indexable=import.meta.env.PUBLIC_INDEXABLE === 'true'&&!editorialPreview;
const site=import.meta.env.PUBLIC_SITE_URL || 'https://nexoneuro.com';
const canonical = new URL(Astro.url.pathname,site).href;
const siteRoot = new URL('/',site).href;
const contentPage=pages.find(page=>Astro.url.pathname===`/${page.slug}/`);
// Search and sharing labels describe the actual subject; visible headings keep
// the editorial language supplied by each page.
const searchTitles:Record<string,string>={
  'para-voce':'Psicoterapia, autoconhecimento e avaliação',
  'psicoterapia':'Psicoterapia breve em Análise do Comportamento',
  'avaliacao-neuropsicologica':'Avaliação neuropsicológica',
  'integracao-psiquiatrica':'Interface com Psiquiatria quando indicada',
  'para-sua-empresa':'Psicologia Organizacional para empresas',
  'recrutamento-e-selecao':'Recrutamento e seleção com Psicologia',
  'treinamento-e-desenvolvimento':'Treinamento e desenvolvimento de pessoas',
  'avaliacao-psicologica-organizacional':'Avaliação psicológica para empresas',
  'riscos-psicossociais-nr1':'NR-1: avaliação de riscos psicossociais',
  'nossa-abordagem':'Análise do Comportamento e cuidado em contexto',
  'profissionais':'Profissionais de Psicologia e Medicina',
  'psicologia-em-pauta':'Psicologia em Pauta: leituras e guias para baixar',
  'contato':'Contato',
  'politica-de-privacidade':'Política de privacidade',
};
const metaTitle=seoTitle||(article?.seoTitle?`${article.seoTitle} | NEXO`:home?'NEXO Inteligência Clínica | Psicoterapia e Neuropsicologia':`${(contentPage&&searchTitles[contentPage.slug])||title}${article?' | Psicologia em Pauta':''} | NEXO`);
const metaImage=image||'/og-image.png';
// Unknown routes, including the static 404, must not inherit production indexing.
const articleApproved=article&&!article.draft&&article.reviewed&&article.approvedForPublication===true&&Boolean(article.publishedAt)&&hasConfirmedEditorialAuthorship(article);
const pageIndexable=indexable&&(home||Boolean(contentPage)||Boolean(articleApproved));
const nav=[['Para você','/para-voce/'],['Para sua empresa','/para-sua-empresa/'],['Nossa perspectiva','/nossa-abordagem/'],['Em pauta','/psicologia-em-pauta/']];
const organizationId=`${siteRoot}#organization`;
const websiteId=`${siteRoot}#website`;
const businessServiceSlugs=['recrutamento-e-selecao','treinamento-e-desenvolvimento','avaliacao-psicologica-organizacional','riscos-psicossociais-nr1'];
const businessServicePage=Boolean(contentPage&&businessServiceSlugs.includes(contentPage.slug));
const breadcrumb=article?{
  '@type':'BreadcrumbList','@id':`${canonical}#breadcrumb`,
  itemListElement:[
    {'@type':'ListItem',position:1,name:'NEXO',item:siteRoot},
    {'@type':'ListItem',position:2,name:'Psicologia em Pauta',item:new URL('/psicologia-em-pauta/',site).href},
    {'@type':'ListItem',position:3,name:article.title,item:canonical},
  ],
}:businessServicePage&&contentPage?{
  '@type':'BreadcrumbList','@id':`${canonical}#breadcrumb`,
  itemListElement:[
    {'@type':'ListItem',position:1,name:'NEXO',item:siteRoot},
    {'@type':'ListItem',position:2,name:'Para sua empresa',item:new URL('/para-sua-empresa/',site).href},
    {'@type':'ListItem',position:3,name:contentPage.eyebrow,item:canonical},
  ],
}:contentPage?{
  '@type':'BreadcrumbList',
  '@id':`${canonical}#breadcrumb`,
  itemListElement:[
    {'@type':'ListItem',position:1,name:'NEXO',item:siteRoot},
    {'@type':'ListItem',position:2,name:contentPage.eyebrow,item:canonical},
  ],
}:undefined;
const schema={
  '@context':'https://schema.org',
  '@graph':[
    {'@type':'Organization','@id':organizationId,name:'NEXO Inteligência Clínica',alternateName:'NEXO',url:siteRoot,telephone:'+55-11-5444-4366'},
    {'@type':'WebSite','@id':websiteId,name:'NEXO Inteligência Clínica',alternateName:'NEXO',url:siteRoot,inLanguage:'pt-BR',publisher:{'@id':organizationId}},
    {'@type':'WebPage','@id':`${canonical}#webpage`,url:canonical,name:title,description,inLanguage:'pt-BR',isPartOf:{'@id':websiteId},about:{'@id':organizationId},...(breadcrumb?{breadcrumb:{'@id':breadcrumb['@id']}}:{}),...(businessServicePage?{mainEntity:{'@id':`${canonical}#service`}}:{})},
    ...(businessServicePage&&contentPage?[{'@type':'Service','@id':`${canonical}#service`,name:searchTitles[contentPage.slug],serviceType:contentPage.eyebrow,description,url:canonical,provider:{'@id':organizationId}}]:[]),
    ...(contentPage?.slug==='para-sua-empresa'?[{'@type':'OfferCatalog','@id':`${canonical}#services`,name:'Psicologia para empresas',itemListElement:pages.filter(page=>businessServiceSlugs.includes(page.slug)).map(page=>({'@type':'Offer',itemOffered:{'@type':'Service',name:searchTitles[page.slug],url:new URL(`/${page.slug}/`,site).href,provider:{'@id':organizationId}}}))}]:[]),
    ...(breadcrumb?[breadcrumb]:[]),
    ...(articleApproved?[{'@type':'Article','@id':`${canonical}#article`,mainEntityOfPage:{'@id':`${canonical}#webpage`},headline:article.title,description,inLanguage:'pt-BR',image:new URL(metaImage,site).href,datePublished:article.publishedAt,dateModified:article.researchReviewedAt||article.migratedAt,author:{'@type':'Person',name:editorialAuthorName(article),url:new URL('/profissionais/#secao-1',site).href},publisher:{'@id':organizationId}}]:[]),
  ],
};
---
<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title>{metaTitle}</title><meta name="description" content={description}/>
  {article&&hasConfirmedEditorialAuthorship(article)&&<meta name="author" content={editorialAuthorName(article)}/>}
  {pageIndexable&&articleApproved&&<><meta property="article:author" content={new URL('/profissionais/#secao-1',site).href}/><meta property="article:published_time" content={article.publishedAt}/><meta property="article:modified_time" content={article.researchReviewedAt||article.migratedAt}/></>}
  <meta name="theme-color" content="#0B2635"/><meta name="robots" content={pageIndexable?'index,follow':'noindex,follow'}/>
  {pageIndexable && <link rel="canonical" href={canonical}/>}
  <meta property="og:type" content={article?'article':'website'}/><meta property="og:title" content={metaTitle}/><meta property="og:description" content={description}/><meta property="og:locale" content="pt_BR"/><meta property="og:site_name" content="NEXO Inteligência Clínica"/>
  {pageIndexable && <meta property="og:url" content={canonical}/>}
  <meta property="og:image" content={new URL(metaImage,site).href}/><meta property="og:image:alt" content={article?article.title:'NEXO — Existe um X em cada história.'}/><meta property="og:image:width" content="1200"/><meta property="og:image:height" content="630"/>
  <meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={metaTitle}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content={new URL(image||'/twitter-card.png',site).href}/>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg"/><link rel="icon" href="/favicon.ico" sizes="any"/><link rel="icon" type="image/png" href="/favicon-16x16.png" sizes="16x16"/><link rel="icon" type="image/png" href="/favicon-32x32.png" sizes="32x32"/><link rel="icon" type="image/png" href="/favicon-48x48.png" sizes="48x48"/><link rel="apple-touch-icon" href="/apple-touch-icon.png"/><link rel="manifest" href="/site.webmanifest"/>
  <link rel="preload" href="/fonts/editorial-latin.woff2" as="font" type="font/woff2" crossorigin/>
  <link rel="preload" href="/fonts/interface-latin.woff2" as="font" type="font/woff2" crossorigin/>
  {pageIndexable && <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g,'\\u003c')}/>}
</head>
<body class:list={[{home,'is-experience':experience}]}>
  <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
  {experience ? <ExperienceNav/> : <header class="site-header">
    <div class="header-inner"><Logo/>
      <nav aria-label="Navegação principal" id="main-nav">{nav.map(([label,url])=><a href={url} aria-current={Astro.url.pathname===url?'page':undefined}>{label}</a>)}<a href="/contato/" class="nav-contact">Vamos conversar <Arrow diagonal/></a></nav>
      <button class="menu-toggle" aria-controls="main-nav" aria-expanded="false" aria-label="Abrir menu"><span></span><span></span></button>
    </div>
    <noscript><nav class="nojs-navigation" aria-label="Navegação sem JavaScript">{nav.map(([label,url])=><a href={url}>{label}</a>)}<a href="/contato/">Contato</a></nav></noscript>
  </header>}
  <main id="conteudo"><slot/></main>
  <AmbientSound/>
  {experience ? <ExperienceFooter/> : <footer class="site-footer">
    <div class="footer-top"><Logo/><p>Ciência para compreender.<br/>Conexões para transformar.</p><a class="back-top" href="#conteudo">Voltar ao início <span>↑</span></a></div>
    <div class="footer-grid"><div><span class="overline">CONVERSAS COMEÇAM AQUI</span><a class="footer-phone" href="tel:+551154444366">+55 (11) 5444-4366</a><a class="text-link" href={whatsapp()} target="_blank" rel="noopener noreferrer">Iniciar conversa no WhatsApp <Arrow diagonal/></a></div><div><span class="overline">ENCONTRE SEU CAMINHO</span><a href="/para-voce/">Para você</a><a href="/para-sua-empresa/">Para sua empresa</a><a href="/profissionais/">Profissionais</a></div><div><span class="overline">EXPLORE A NEXO</span><a href="/nossa-abordagem/">Nossa abordagem</a><a href="/psicologia-em-pauta/">Psicologia em Pauta</a><a href="/politica-de-privacidade/">Privacidade</a></div></div>
    <div class="professional-footnote"><p>Gabriel Alves Batista · CRP-SP 06/176184<br/>Ivo Peixoto Barbosa Júnior · CRM-SP 193133</p><p><a href="/profissionais/">Conheça a atuação dos profissionais ↗</a></p></div>
    <div class="footer-bottom"><span>© 2026 NEXO Inteligência Clínica</span><span>Singular em cada conexão.</span></div>
  </footer>}
  <script>
    const menu=document.querySelector<HTMLButtonElement>('.menu-toggle');
    const nav=document.querySelector<HTMLElement>('#main-nav');
    const close=()=>{menu?.setAttribute('aria-expanded','false');menu?.setAttribute('aria-label','Abrir menu');nav?.classList.remove('is-open')};
    menu?.addEventListener('click',()=>{const open=menu.getAttribute('aria-expanded')!=='true';menu.setAttribute('aria-expanded',String(open));menu.setAttribute('aria-label',open?'Fechar menu':'Abrir menu');nav?.classList.toggle('is-open',open)});
    document.addEventListener('keydown',e=>{if(e.key==='Escape'&&nav?.classList.contains('is-open')){close();menu?.focus()}});
    nav?.querySelectorAll('a').forEach(a=>a.addEventListener('click',close));
  </script>
</body>
</html>
