---
import Layout from '../layouts/Layout.astro';
import Arrow from '../components/Arrow.astro';
import { reflections, dimensions, whatsapp } from '../data/reflections';
const first=reflections[0];
const services=[
 {n:'01',title:'Psicoterapia',tag:'ESCUTA & DESENVOLVIMENTO',text:'Um espaço de escuta qualificada para compreender sua experiência e construir caminhos possíveis.',url:'/psicoterapia/'},
 {n:'02',title:'Avaliação neuropsicológica',tag:'INVESTIGAÇÃO & COMPREENSÃO',text:'Uma investigação individualizada de funções cognitivas, comportamento e contexto, com devolutiva e laudo quando cabível.',url:'/avaliacao-neuropsicologica/'},
 {n:'03',title:'Interface com Psiquiatria',tag:'DIÁLOGO & CUIDADO',text:'Integração interdisciplinar quando indicada após o acolhimento e a anamnese. A avaliação psiquiátrica não é obrigatória para todos.',url:'/integracao-psiquiatrica/'}
];
---
<Layout title="Existe um X em cada história" description="Ciência, escuta e um olhar biopsicossocial. Conheça a proposta da NEXO para pessoas e organizações e explore novas perguntas." home>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-grid content-width">
      <div class="hero-copy"><div class="overline hero-kicker"><span class="tiny-star">✳</span> TODO ENCONTRO COMEÇA COM UMA PERGUNTA</div>
        <h1 id="hero-title">Existe um <span class="inline-x">X</span><br/> em cada<br/> história<span class="copper">.</span></h1>
        <p class="hero-question">Qual é o seu?</p>
        <p class="hero-description">Antes de encontrar respostas,<br/> precisamos compreender a pergunta.</p>
        <div class="hero-actions"><a href="#descoberta" class="button button-copper" data-start-journey>Começar <Arrow/></a><a class="hero-path" href="/para-voce/">Para você</a><a class="hero-path" href="/para-sua-empresa/">Para sua empresa</a></div>
      </div>
      <div class="hero-art" id="nexo-universe" aria-label="X formado por partículas e conexões, uma interpretação visual da descoberta" role="img">
        <div class="art-halo"></div><canvas id="nexo-canvas" aria-hidden="true"></canvas>
        <svg class="x-fallback" viewBox="0 0 600 680" aria-hidden="true"><defs><linearGradient id="x-light" x1="0" y1="0" x2="1" y2="1"><stop stop-color="#e5c1a3"/><stop offset=".5" stop-color="#b77950"/><stop offset="1" stop-color="#f6f2ea"/></linearGradient><pattern id="dot-grid" width="9" height="9" patternUnits="userSpaceOnUse"><circle cx="3" cy="3" r="1.35" fill="url(#x-light)"/></pattern><filter id="x-glow"><feGaussianBlur stdDeviation="5"/></filter></defs><g fill="none" stroke="#9ab9b0" stroke-width=".6" opacity=".25"><circle cx="300" cy="330" r="230"/><ellipse cx="300" cy="330" rx="255" ry="170" transform="rotate(-28 300 330)"/><circle cx="300" cy="330" r="275" stroke-dasharray="1 18"/></g><path d="m155 130 290 400m0-400L155 530" stroke="url(#x-light)" stroke-width="22" opacity=".2" filter="url(#x-glow)"/><path d="M133 133h66l108 151 107-151h56L337 329l142 206h-68L299 374 187 535h-61l141-207Z" fill="url(#dot-grid)"/><g stroke="#d8b093" opacity=".25" stroke-width=".5"><path d="m162 180 220 270-207-50 160-170-30 245-100-270 240 230-110 15-170-220M198 460l209-242-215 20 207 228-8-271-195 292"/></g><g fill="#e2c3a9"><circle cx="105" cy="210" r="2"/><circle cx="478" cy="353" r="2.5"/><circle cx="366" cy="90" r="1.5"/><circle cx="217" cy="580" r="1.5"/><circle cx="97" cy="426" r="2"/></g></svg>
        <span class="constellation-label label-memory">memória</span><span class="constellation-label label-identity">identidade</span><span class="constellation-label label-context">contexto</span><span class="constellation-label label-bonds">vínculos</span><span class="scene-wordmark" aria-hidden="true"><span>NE<i>X</i>O</span><small>INTELIGÊNCIA CLÍNICA</small></span><span class="art-coordinate">X / POSSIBILIDADES INFINITAS</span>
      </div>
    </div>
    <div class="hero-bottom content-width"><a href="#perspectiva" class="scroll-cue"><span>↓</span> UM NOVO OLHAR SOBRE A SUA HISTÓRIA</a><div class="effect-controls"><button id="skip-intro">Pular introdução</button><button id="pause-effects" aria-pressed="false"><span class="pause-icon" aria-hidden="true">Ⅱ</span> <span data-pause-label>Pausar efeitos</span></button></div><span class="hero-index">01 <i>/</i> CONEXÃO</span></div>
  </section>

  <section class="perspective section-pad" id="perspectiva" aria-labelledby="perspective-title">
    <div class="content-width perspective-grid"><div class="perspective-copy"><span class="overline"><span class="section-number">01 /</span> NOSSA PERSPECTIVA</span><h2 id="perspective-title">Uma pessoa.<br/> <em>Muitas dimensões.</em></h2><p class="lead">Você é mais do que uma única característica.</p><p>Corpo, pensamentos e relações se conectam em cada história. Nosso olhar parte desse encontro para compreender a singularidade de cada pessoa.</p><a class="text-link dark-link" href="/nossa-abordagem/">Conheça o olhar biopsicossocial <Arrow diagonal/></a></div>
      <div class="dimension-experience"><div class="venn" role="group" aria-label="Explore as três dimensões do olhar biopsicossocial"><span class="venn-line"></span>{dimensions.map((d,i)=><button class:list={['dimension-circle',`circle-${i}`,{'is-active':i===0}]} data-dimension={d.id} aria-pressed={i===0}><small>{d.number}</small><span>{d.title}</span><span class="circle-plus" aria-hidden="true">+</span></button>)}<span class="venn-center" aria-hidden="true">X</span></div><div class="dimension-result" aria-live="polite" aria-atomic="true"><span class="overline" id="dimension-title">DIMENSÃO BIOLÓGICA</span><p id="dimension-text">{dimensions[0].text}</p><p class="dimension-connection" id="dimension-connection">{dimensions[0].connection}</p></div><p class="interaction-hint"><span aria-hidden="true">↗</span> Selecione uma dimensão para explorar suas conexões.</p></div>
    </div>
    <noscript><div class="content-width noscript-dimensions">{dimensions.map(d=><p><strong>{d.title}: </strong>{d.text} {d.connection}</p>)}</div></noscript>
  </section>

  <section class="discovery section-pad" id="descoberta" aria-labelledby="discovery-title">
    <div class="content-width"><div class="section-heading"><div><span class="overline"><span class="section-number">02 /</span> EXPLORE UMA IDEIA</span><h2 id="discovery-title">Permita-se <em>questionar.</em></h2></div><p>Algumas perguntas abrem<br/> novos caminhos.</p></div>
      <div class="discovery-shell"><div class="reflection-categories" role="group" aria-label="Categorias de reflexão">{reflections.map((r,i)=><button data-reflection={i} aria-pressed={i===0} class:list={[{'is-active':i===0}]}>{r.category}<span aria-hidden="true">↗</span></button>)}</div><div class="reflection-main"><span class="reflection-label"><span class="live-dot"></span><span id="reflection-category">{first.category}</span> / UMA PERGUNTA, NOVAS CONEXÕES</span><blockquote id="reflection-question">{first.question}</blockquote><p id="reflection-context">{first.context}</p><div class="reflection-bottom"><a href={first.link} id="reflection-link" class="text-link"><span>{first.label}</span><Arrow diagonal/></a><button class="next-reflection" id="next-reflection" aria-label="Explorar outra ideia"><Arrow/></button></div></div><div class="reflection-aside"><span class="outline-x" aria-hidden="true">x</span><div><span class="overline">O X É UMA INCÓGNITA.</span><p>Uma abertura<br/> para o que ainda<br/> podemos conhecer.</p><span class="small-caption">Exploração livre. Sem testes,<br/> pontuações ou diagnósticos.</span></div></div></div>
    </div>
  </section>

  <section class="paths section-pad" id="caminhos" aria-labelledby="paths-title"><div class="content-width"><div class="section-heading"><div><span class="overline"><span class="section-number">03 /</span> CONEXÕES QUE IMPORTAM</span><h2 id="paths-title">Dois caminhos.<br/> <em>Um propósito.</em></h2></div><p>Compreender pessoas.<br/> Ampliar possibilidades.</p></div><div class="path-grid"><a class="path-card personal-path" href="/para-voce/"><div class="path-top"><span class="overline">SUA HISTÓRIA, EM PRIMEIRO LUGAR</span><span class="path-symbol" aria-hidden="true">( x )</span></div><div><h3>Para você<span>.</span></h3><p>Escuta, investigação e cuidado para compreender o que torna sua experiência única.</p><span class="path-link">Conheça os atendimentos <Arrow diagonal/></span></div></a><a class="path-card business-path" href="/para-sua-empresa/"><div class="path-top"><span class="overline">PESSOAS TAMBÉM CONSTROEM RESULTADOS</span><span class="path-symbol" aria-hidden="true">x + x</span></div><div><h3>Para sua empresa<span>.</span></h3><p>Um olhar estratégico para pessoas, relações e saúde mental no contexto do trabalho.</p><span class="path-link">Explore as soluções <Arrow diagonal/></span></div></a></div></div></section>

  <section class="services section-pad" aria-labelledby="services-title"><div class="content-width services-grid"><div class="services-intro"><span class="overline"><span class="section-number">04 /</span> PARA VOCÊ</span><h2 id="services-title">O cuidado começa<br/> <em>pela compreensão.</em></h2><p>O caminho é construído a partir da sua demanda, com clareza, respeito e participação.</p><a href="/para-voce/" class="text-link dark-link">Encontre seu caminho <Arrow diagonal/></a><div class="care-statement"><span aria-hidden="true">✳</span><p>Cada história pede<br/> um olhar singular.</p></div></div><div class="service-list">{services.map(s=><a href={s.url} class="service-row"><span class="service-number">{s.n}</span><div><span class="overline">{s.tag}</span><h3>{s.title}</h3><p>{s.text}</p></div><span class="service-arrow"><Arrow diagonal/></span></a>)}</div></div></section>

  <section class="business-feature" aria-labelledby="business-title"><div class="content-width business-feature-grid"><div class="business-art" aria-hidden="true"><svg viewBox="0 0 500 400" fill="none"><g stroke="currentColor" stroke-width=".8"><path d="M50 340 250 55l200 285H50Zm80 0L250 170l120 170M100 270h300M150 195h200M200 125h100M250 55v285"/><ellipse cx="250" cy="340" rx="220" ry="35"/><circle cx="250" cy="55" r="12"/><circle cx="50" cy="340" r="7"/><circle cx="450" cy="340" r="7"/><circle cx="250" cy="170" r="7"/></g></svg><span>INDIVÍDUO ↔ RELAÇÕES ↔ ORGANIZAÇÃO</span></div><div><span class="overline">PARA SUA EMPRESA</span><h2 id="business-title">Por trás de todo resultado,<br/> <em>existem pessoas.</em></h2><p>Consultoria, desenvolvimento de lideranças e compreensão dos fatores de risco psicossociais relacionados ao trabalho.</p><div class="business-topics"><span>Cultura & relações</span><span>Desenvolvimento humano</span><span>Saúde mental no trabalho</span></div><a class="button button-dark" href="/para-sua-empresa/">Conecte-se a novas possibilidades <Arrow/></a><a href="/riscos-psicossociais-nr1/" class="business-nr">Conheça a proposta para riscos psicossociais e NR-1 ↗</a></div></div></section>

  <section class="editorial section-pad" aria-labelledby="editorial-title"><div class="content-width"><div class="section-heading"><div><span class="overline"><span class="section-number">05 /</span> CONHECIMENTO EM MOVIMENTO</span><h2 id="editorial-title">Psicologia <em>em Pauta.</em></h2></div><a class="text-link dark-link" href="/psicologia-em-pauta/">Conheça o espaço editorial <Arrow diagonal/></a></div><div class="editorial-grid"><a class="editorial-card" href="/psicologia-em-pauta/#temas"><div class="editorial-image image-cognition" aria-hidden="true"><div class="cognitive-orbit orbit-a"></div><div class="cognitive-orbit orbit-b"></div><div class="cognitive-orbit orbit-c"></div><span>01 — COGNIÇÃO</span></div><span class="overline">NEUROPSICOLOGIA</span><h3>Além de um resultado,<br/> uma história a compreender.</h3><p>Tema previsto · Conteúdo em preparação</p><Arrow diagonal/></a><a class="editorial-card" href="/psicologia-em-pauta/#temas"><div class="editorial-image image-relations" aria-hidden="true"><span class="abstract-face face-a"></span><span class="abstract-face face-b"></span><span>02 — RELAÇÕES</span></div><span class="overline">COMPORTAMENTO & SOCIEDADE</span><h3>O encontro entre quem somos<br/> e o mundo que habitamos.</h3><p>Tema previsto · Conteúdo em preparação</p><Arrow diagonal/></a><a class="editorial-card" href="/psicologia-em-pauta/#temas"><div class="editorial-image image-work" aria-hidden="true"><span class="column col-a"></span><span class="column col-b"></span><span class="column col-c"></span><span>03 — TRABALHO</span></div><span class="overline">PESSOAS & ORGANIZAÇÕES</span><h3>Que perguntas o trabalho<br/> precisa voltar a fazer?</h3><p>Tema previsto · Conteúdo em preparação</p><Arrow diagonal/></a></div><p class="editorial-note">Um espaço em construção. Os artigos serão publicados com autoria, referências e revisão profissional.</p></div></section>

  <section class="people section-pad" aria-labelledby="people-title"><div class="content-width"><div class="section-heading"><div><span class="overline"><span class="section-number">06 /</span> QUEM CONECTA ESSE OLHAR</span><h2 id="people-title">Ciência com <em>presença humana.</em></h2></div><a href="/profissionais/" class="text-link">Conheça os profissionais <Arrow diagonal/></a></div><div class="people-grid"><div class="person"><div class="portrait"><img src="/images/gabriel.webp" width="700" height="727" loading="lazy" decoding="async" alt="Gabriel Alves Batista, em fotografia fornecida para o projeto"/></div><div class="person-info"><span class="overline">AVALIAÇÃO NEUROPSICOLÓGICA</span><h3>Gabriel Alves Batista</h3><p>CRP-SP 06/176184</p><span class="validation-note">Título informado: Neuropsicólogo · validação pendente</span></div></div><div class="person"><div class="portrait portrait-second"><img src="/images/ivo.webp" width="700" height="754" loading="lazy" decoding="async" alt="Ivo Peixoto Barbosa Júnior, em fotografia fornecida para o projeto"/></div><div class="person-info"><span class="overline">INTERFACE MÉDICA</span><h3>Ivo Peixoto Barbosa Júnior</h3><p>CRM-SP 193133</p><span class="validation-note">Especialidade informada: Psiquiatria · RQE pendente</span></div></div></div><p class="people-note">Apresentação preliminar com dados e fotografias fornecidos. Registros, títulos, especialidade e uso público das imagens aguardam validação antes da publicação.</p></div></section>

  <section class="approach section-pad"><div class="content-width approach-grid"><span class="overline"><span class="section-number">07 /</span> NOSSA ABORDAGEM</span><div><h2>Investigar com rigor.<br/> Escutar com atenção.<br/> <em>Compreender com humanidade.</em></h2><div class="approach-bottom"><p>Ciência, ética e respeito à individualidade orientam a proposta NEXO. O cuidado começa quando há espaço para a complexidade de cada história.</p><a class="circle-link" href="/nossa-abordagem/" aria-label="Conheça nossa abordagem"><Arrow diagonal/></a></div></div></div></section>

  <section class="contact-section section-pad" aria-labelledby="contact-title"><div class="content-width"><span class="overline">SEU PRÓXIMO PASSO PODE SER UMA CONVERSA.</span><h2 id="contact-title">Toda história merece<br/> ser <em>compreendida.</em></h2><a class="button button-copper" href={whatsapp()} target="_blank" rel="noopener noreferrer">Vamos conversar <Arrow diagonal/></a><p>Sem antecipar respostas. Com abertura para escutar.</p><a class="contact-secondary" href="/contato/">Outras formas de contato</a><span class="contact-x" aria-hidden="true">x</span></div></section>

  <dialog id="journey-dialog" aria-labelledby="journey-title"><button class="dialog-close" aria-label="Fechar exploração">×</button><span class="overline">UMA EXPLORAÇÃO, SEM RESPOSTAS CERTAS</span><h2 id="journey-title">O que desperta<br/> <em>sua curiosidade?</em></h2><p>Escolha um ponto de partida. Nada será pontuado ou armazenado.</p><div class="journey-options"><button aria-pressed="false" data-journey="historia">Minha história <Arrow/></button><button aria-pressed="false" data-journey="relacoes">Minhas relações <Arrow/></button><button aria-pressed="false" data-journey="trabalho">O mundo do trabalho <Arrow/></button><button aria-pressed="false" data-journey="incognita">Os sentidos do X <Arrow/></button></div><div id="journey-answer" aria-live="polite" hidden><span class="overline" id="journey-answer-label"></span><p id="journey-answer-text"></p><a id="journey-answer-link" class="text-link dark-link" href="/nossa-abordagem/">Continuar explorando <Arrow diagonal/></a></div><span class="small-caption">Convite à reflexão. Não é um teste psicológico ou avaliação clínica.</span></dialog>
  <script>import '../scripts/interactions'; import '../scripts/scene';</script>
  <script type="application/json" id="reflection-data" set:html={JSON.stringify(reflections)}/>
  <script type="application/json" id="dimension-data" set:html={JSON.stringify(dimensions)}/>
</Layout>



