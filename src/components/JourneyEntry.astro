---
import ExperienceStage from './ExperienceStage.astro';
import ProfessionalEncounter from './ProfessionalEncounter.astro';
import CarePathways from './CarePathways.astro';
import SelfObservation from './SelfObservation.astro';
import '../styles/experience.css';
interface Props {type:'personal'|'business';title:string;intro:string;eyebrow?:string;reading?:boolean;human?:boolean}
const {type,title,intro,eyebrow,reading=false,human=true}=Astro.props;
const personal=type==='personal';
---
<section class:list={['ex-journey-entry',personal?'entry-personal':'entry-business',{'entry-reading':reading}]} id="experience-entry" aria-labelledby="entry-title"><ExperienceStage entry={type}/><div class="ex-entry-copy"><a href="/#experience-paths" class="ex-entry-back">← Voltar às conexões</a><span class="ex-eyebrow">{eyebrow||(personal?'01 / PARA VOCÊ':'02 / PARA SUA EMPRESA')}</span><h1 id="entry-title">{title}</h1><p>{intro}</p><a href="#conteudo-da-jornada" class="ex-primary-link">{reading?'Continue a leitura':personal?'Conheça os caminhos de cuidado':'Explore as possibilidades'} <span aria-hidden="true">↓</span></a></div><span class="ex-entry-coordinate" aria-hidden="true">{reading?'PERGUNTAS ↔ CONTEXTO ↔ COMPREENSÃO':personal?'SINGULARIDADE ↔ HISTÓRIA ↔ CUIDADO':'PESSOAS ↔ RELAÇÕES ↔ ORGANIZAÇÃO'}</span><div class="ex-controls"><button id="experience-pause" aria-pressed="false">Pausar movimento</button></div></section>
{human&&personal&&<CarePathways id="journey-care"/>}
{human&&personal&&<SelfObservation id="journey-self-observation"/>}
{human&&personal&&<ProfessionalEncounter id="journey-people" title="Compreender também é encontrar pessoas." compact/>}
{human&&!personal&&<section class="ex-entry-human-strip" aria-label="Uma proposta que conecta ciência e pessoas"><div><span class="ex-eyebrow">{personal?'CUIDADO COM PRESENÇA HUMANA':'COMPREENSÃO DO CONTEXTO'}</span><p>{personal?'Antes de escolher um caminho, há espaço para sua pergunta.':'Pessoas também constroem resultados.'}</p></div><img src="/images/gabriel.webp" width="700" height="727" loading="lazy" alt="Gabriel Alves Batista, em fotografia real fornecida"/><a href="/profissionais/">Conheça os profissionais ↗</a></section>}
<script>import '../scripts/experience-ui';</script>
