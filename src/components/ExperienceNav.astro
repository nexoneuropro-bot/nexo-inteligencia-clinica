---
import Logo from './Logo.astro';
const links=[['Explorar','/#experience-ideas'],['Nossa abordagem','/nossa-abordagem/'],['Para você','/para-voce/'],['Empresas','/para-sua-empresa/'],['Psicoterapia breve','/psicoterapia/'],['Em pauta','/psicologia-em-pauta/'],['Conversar','/contato/']];
---
<header class="ex-header"><Logo/><nav class="ex-desktop-navigation" aria-label="Navegação da experiência">{links.map(([label,url])=><a href={url} aria-current={Astro.url.pathname===url?'page':undefined}>{label}<span aria-hidden="true">↗</span></a>)}</nav><details class="ex-mobile-menu"><summary>Caminhos <span aria-hidden="true">+</span></summary><nav class="ex-mobile-navigation" aria-label="Caminhos da NEXO">{links.map(([label,url])=><a href={url} aria-current={Astro.url.pathname===url?'page':undefined}>{label}<span aria-hidden="true">↗</span></a>)}</nav></details></header>
<script>
 const menu=document.querySelector<HTMLDetailsElement>('.ex-mobile-menu');
 menu?.querySelectorAll('a').forEach(link=>link.addEventListener('click',()=>{menu.open=false;}));
 document.addEventListener('keydown',event=>{if(event.key==='Escape'&&menu?.open){menu.open=false;menu.querySelector('summary')?.focus();}});
 document.addEventListener('pointerdown',event=>{if(menu?.open&&event.target instanceof Node&&!menu.contains(event.target))menu.open=false;});
</script>
<style is:global>
 .ex-header .ex-desktop-navigation {gap:24px;}
 .ex-header nav a[aria-current="page"] {color:#f0c59f;text-decoration:underline;text-underline-offset:6px;}
 .ex-mobile-menu {display:none;}
 @media(max-width:1250px){
  .ex-header .ex-desktop-navigation {display:none;}
  .ex-mobile-menu {display:block;}
  .ex-mobile-menu summary {list-style:none;border:1px solid #bc9c7777;border-radius:30px;padding:10px 16px;font-size:11px;color:#efe4d4;cursor:pointer;min-height:44px;}
  .ex-mobile-menu summary::-webkit-details-marker {display:none;}
  .ex-mobile-menu summary span {margin-left:18px;color:#ddb18d;}
  .ex-header details .ex-mobile-navigation {position:absolute;right:22px;top:70px;display:flex;flex-direction:column;align-items:stretch;gap:0;width:min(310px,calc(100vw - 44px));padding:14px 24px 22px;background:#071f2df5;border:1px solid #bc9c7755;box-shadow:0 24px 70px #010a13aa;backdrop-filter:blur(16px);}
  .ex-header details:not([open]) .ex-mobile-navigation {display:none;}
  .ex-header details .ex-mobile-navigation a,.ex-header details .ex-mobile-navigation a:first-child,.ex-header details .ex-mobile-navigation a:last-child {display:flex;justify-content:space-between;align-items:center;font:24px/1.3 var(--serif);letter-spacing:0;border:0;border-bottom:1px solid #c3b59d33;border-radius:0;min-height:56px;padding:13px 0;color:#ece4d6;}
  .ex-header details .ex-mobile-navigation a span {font:13px var(--sans);}
  .ex-mobile-menu summary:focus-visible {outline:2px solid #f0c59f;outline-offset:5px;}
 }
 @media(min-width:1251px) and (max-width:1450px){.ex-header .ex-desktop-navigation {gap:14px;}.ex-header nav a span {margin-left:5px;}}
</style>
